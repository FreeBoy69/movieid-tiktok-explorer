#!/bin/sh
set -eu
if [ "${1:-}" = "--version" ]; then
  printf 'autoyt-promo-render 1\n'
  exit 0
fi
mode=render
if [ "${1:-}" = "--inspect" ] || [ "${1:-}" = "--capture" ]; then
  mode=${1#--}
  shift
fi
if { [ "$mode" = render ] && [ "$#" -ne 7 ]; } || { [ "$mode" != render ] && [ "$#" -ne 6 ]; }; then
  echo 'Invalid Promo worker arguments' >&2
  exit 2
fi
stage=$(mktemp -d /tmp/autoyt-promo-render-XXXXXX)
trap 'rm -rf "$stage"' EXIT HUP INT TERM
chmod 755 "$stage"
if [ "$mode" != capture ]; then
  cp "$1" "$stage/film.html"
  chmod 644 "$stage/film.html"
fi
audio=-
if [ "$mode" = render ] && [ "$7" != - ]; then
  cp "$7" "$stage/music.wav"
  chmod 644 "$stage/music.wav"
  audio="$stage/music.wav"
fi
chown 65534:65534 "$stage"
if [ "$mode" = capture ]; then
  env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$stage" TMPDIR="$stage" PROMO_CHROME_PATH=/opt/autoyt/promo-renderer/chrome/chrome-headless-shell APP_URL="${APP_URL:-https://autoyt.cc}" WORKER_SCRIPT_TOKEN="${WORKER_SCRIPT_TOKEN:-}" \
    setpriv --reuid=65534 --regid=65534 --clear-groups \
    /usr/bin/node /opt/autoyt/promo-renderer/promo-capture.mjs "$1" "$stage/site.json" "$3" "$4" "$5" "$6"
  cp "$stage/site.json" "$2"
elif [ "$mode" = inspect ]; then
  env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$stage" TMPDIR="$stage" PROMO_CHROME_PATH=/opt/autoyt/promo-renderer/chrome/chrome-headless-shell \
    setpriv --reuid=65534 --regid=65534 --clear-groups \
    /usr/bin/node /opt/autoyt/promo-renderer/promo-render.mjs --inspect "$stage/film.html" "$stage/report.json" "$3" "$4" "$5" "$6"
  cp "$stage/report.json" "$2"
else
  env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="$stage" TMPDIR="$stage" PROMO_CHROME_PATH=/opt/autoyt/promo-renderer/chrome/chrome-headless-shell \
    setpriv --reuid=65534 --regid=65534 --clear-groups \
    /usr/bin/node /opt/autoyt/promo-renderer/promo-render.mjs "$stage/film.html" "$stage/film.mp4" "$3" "$4" "$5" "$6" "$audio"
  cp "$stage/film.mp4" "$2"
fi
